{
  "name": "prayer-pause",
  "version": "0.4.0",
  "description": "Prayer times, prayer sessions and app restrictions for Windows",
  "main": "main.js",
  "private": true,
  "license": "UNLICENSED",
  "author": "Your Name",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/core.test.js",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "adhan": "^4.4.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.example.prayerpause",
    "productName": "Prayer Pause",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "Prayer-Pause-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Prayer Pause",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
